# Local-only configuration for this repo.
# This file is intentionally gitignored.

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# LLM backend
# -----------------------------------------------------------------------------
LLM_BACKEND=openai
LLM_BASE_URL=http://host.docker.internal:9061
VLLM_BASE_URL=http://host.docker.internal:9061
MODEL_NAME=qwen3-14b

# -----------------------------------------------------------------------------
# FireAnt API
# -----------------------------------------------------------------------------
FIREANT_BASE_URL=https://restv2.fireant.vn
FIREANT_TOKEN=REPLACE_WITH_YOUR_FIREANT_TOKEN

# Common FireAnt endpoints used by this codebase:
# - ${FIREANT_BASE_URL}/symbols/{SYMBOL}/officers
# - ${FIREANT_BASE_URL}/symbols/{SYMBOL}/subsidiaries
# - ${FIREANT_BASE_URL}/symbols/{SYMBOL}/holders
# - ${FIREANT_BASE_URL}/individuals/{INDIVIDUAL_ID}/profile
# - ${FIREANT_BASE_URL}/individuals/{INDIVIDUAL_ID}/jobs
# - ${FIREANT_BASE_URL}/individuals/{INDIVIDUAL_ID}/assets
# - ${FIREANT_BASE_URL}/individuals/{INDIVIDUAL_ID}/relations
