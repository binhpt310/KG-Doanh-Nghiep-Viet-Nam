# Python cache
**/__pycache__
**/*.pyc
**/*.pyo

# Local env (not needed in Docker)
backend/.env

# IDE / editor
backend/.cursor
backend/.agents
.vscode
.idea

# Documentation (not needed at runtime)
backend/*.md

# Neo4j export dumps (large files)
backend/Neo4j-*.txt

# Git
.git
.gitignore

# Docker files (already in build context)
docker-compose.yml
Dockerfile
.dockerignore

# Large data files (exclude very large files, keep necessary config)
backend/data/*.csv
backend/data/*.parquet
backend/data/*.sqlite
# Keep: data/config/, data/kg_data/, data/processed/; docs/ copied via Dockerfile → /app/docs/

# Node modules (if any)
node_modules

